# Valen Learning - configuration du serveur uniquement.
# Copie ce fichier vers .env, qui ne doit jamais etre publie.
APP_PORT=8080
# 0.0.0.0 rend le site accessible au reseau local. Ne pas ouvrir ce port sur la box.
BIND_ADDRESS=0.0.0.0
# Sous Linux : les valeurs de id -u et id -g.
PUID=1000
PGID=1000
APP_USERNAME=valentin
# Obligatoire : choisir un mot de passe personnel de 12 caracteres minimum.
# Les scripts configurer generent automatiquement un mot de passe aleatoire.
APP_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD

# Cle API OpenAI privee. Une valeur vide conserve les jeux sans IA.
# Ne pas utiliser de prefixe VITE_ pour cette variable.
OPENAI_API_KEY=
# Modele compatible Responses API et Structured Outputs.
OPENAI_MODEL=gpt-4.1-mini
# Garde-fous locaux communs a tous les appareils. Ce n'est pas un budget en euros.
AI_DAILY_LIMIT=30
AI_MAX_OUTPUT_TOKENS=6000
